<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:padding="12dp"
    android:layout_height="match_parent">

        <View
            android:id="@+id/image_video"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="20dp"
            android:background="@color/shimmerColor"
            app:layout_constraintBottom_toTopOf="@+id/pdfTxt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <View
            android:id="@+id/pdfIconView"
            android:layout_width="30dp"
            android:layout_height="0dp"
            android:background="@color/shimmerColor"
            app:layout_constraintBottom_toBottomOf="@+id/pdfTxt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/pdfTxt" />


        <View
            android:id="@+id/pdfTxt"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="10sp"
            android:background="@color/shimmerColor"
            app:layout_constraintBottom_toTopOf="@+id/pdfSizeTxt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/pdfIconView" />

        <View
            android:id="@+id/pdfSizeTxt"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_marginBottom="5dp"
            android:background="@color/shimmerColor"
            app:layout_constraintBottom_toTopOf="@+id/view8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:id="@+id/view8"
            android:layout_width="15dp"
            android:layout_height="10dp"
            android:background="@color/shimmerColor"
            android:layout_marginBottom="5dp"
            android:paddingStart="2dp"
            android:paddingTop="1dp"
            android:paddingEnd="2dp"
            android:paddingBottom="1dp"
            app:layout_constraintBottom_toTopOf="@+id/materialButton"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:id="@+id/materialButton"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:background="@color/shimmerColor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>