<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@drawable/bg_conner_12"
    android:backgroundTint="@color/appIconColor"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tìm Khóa Ứng Dụng và bật nó lên"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/im_close_button" />

    </LinearLayout>

    <!-- App item -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="Khóa Ứng Dụng"
            android:textColor="#202124"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Fake switch -->
        <View
            android:id="@+id/ivSwitch"
            android:layout_width="44dp"
            android:layout_height="26dp" />

        <!-- Hand -->
        <TextView
            android:id="@+id/ivHand"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="👉"
            android:textSize="24sp" />

    </LinearLayout>

</LinearLayout>