<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_color_ad">

    <!-- SHIMMER: Hiện khi đang Load. (Cần config ngắt khỏi NativeAdView để Meta Bidding ko bị Occlusion) -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmer_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="180dp"
        app:shimmer_auto_start="true">

        <include layout="@layout/shimer_top_layout_recycler_native" />
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- NATIVE AD VIEW: Hiển thị khi Load xong -->
    <com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView
        android:id="@+id/native_ad_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ad_content_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_color_ad"
            android:paddingBottom="12dp">

            <!-- BAT BUOC CHO META: MediaView phải VISIBLE, ko lồng sâu -->
            <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
                android:id="@+id/media_view"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Wrapper Panel chứa NỘI DUNG CHÍNH (Icon, Title, Body). 
                 Giúp Thư viện dễ dàng xác định khối cần giữ lại khi collapse -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/data_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/media_view">

                <!-- ICON -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/imvCardView"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ad_app_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <!-- AD BADGE -->
                <TextView
                    android:id="@+id/ad_notification_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_stroke_noti_ad"
                    android:gravity="center"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="@string/ad_label"
                    android:textColor="@color/tv_color_stroke_ad"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/imvCardView"
                    app:layout_constraintTop_toTopOf="@+id/imvCardView" />

                <!-- HEADLINE -->
                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/tv_color_title_ad"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/ad_notification_view"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ad_notification_view"
                    app:layout_constraintTop_toTopOf="@+id/ad_notification_view"
                    tools:text="Ads Headline" />

                <!-- BODY -->
                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/tv_color_content_ad"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/ad_notification_view"
                    app:layout_constraintTop_toBottomOf="@+id/ad_headline"
                    tools:text="This is the description of the ad that explains everything about this particular ad." />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- CALL TO ACTION -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/ad_call_to_action"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_gradient_conner_23"
                android:gravity="center"
                android:text="@string/action_install_now"
                android:textColor="@color/tv_color_button_ads"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/data_panel" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>

    <!-- Nút đóng/mở Collapse -->
    <ImageView
        android:id="@+id/btn_close_ad"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_conner_12"
        android:backgroundTint="@color/bg_color_button_ads"
        android:elevation="4dp"
        android:padding="6dp"
        android:rotation="-90"
        android:src="@drawable/ic_back"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/tv_color_button_ads" />
</FrameLayout>
